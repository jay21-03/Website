DB_HOST=localhost
DB_PORT=5433
DB_NAME=bautruc_ecommerce
DB_USERNAME=bautruc
DB_PASSWORD=bautruc_local

# Host Maven workflow, if needed:
DB_URL=jdbc:postgresql://localhost:5433/bautruc_ecommerce
#
# Docker Compose backend uses the internal Docker network URL instead:
# jdbc:postgresql://postgres:5432/bautruc_ecommerce

SPRING_PROFILES_ACTIVE=local

JAVA_TOOL_OPTIONS=-Duser.timezone=Asia/Ho_Chi_Minh

JWT_SECRET_BASE64=<replace-with-local-base64-secret>
JWT_ISSUER=bautruc-ecommerce
JWT_TTL_SECONDS=7200

GOOGLE_CLIENT_ID=<google-client-id>
ADMIN_EMAILS=<comma-separated-admin-emails>

PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_BASE_URL=

FRONTEND_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

AWS_REGION=<aws-region>
S3_BUCKET_NAME=<dev-bucket>
S3_PUBLIC_BASE_URL=<public-base-url>
IMAGE_MAX_BYTES=5242880

AUTH_COOKIE_DOMAIN=
